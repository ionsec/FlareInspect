# FlareInspect Environment Configuration
# Copy this file to .env and update with your values.
#
# NOTE: Notifications, the AI planner, and SIEM credentials can ALSO be set from
# the web dashboard's Settings page (which persists to web/data/settings.json and
# overrides these vars). The remediation gate below is env-only by design.

# ── Cloudflare ──────────────────────────────────────────────────────────────
CLOUDFLARE_TOKEN=your_cloudflare_api_token_here

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Set to true to enable detailed Cloudflare API debug logging
CLOUDFLARE_DEBUG=false
# Alternative: Set DEBUG=true to enable debug mode
# DEBUG=true

# ── Output / CLI ────────────────────────────────────────────────────────────
DEFAULT_OUTPUT_DIR=./output
QUIET_MODE=false
NO_BANNER=false
NODE_ENV=production

# ── Web dashboard ───────────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=3000
# When set, every /api/* request must send `X-API-Key: <value>`
# FLAREINSPECT_API_KEY=

# ── Remediation gate (ENV-ONLY — cannot be toggled from the UI) ─────────────
# Master kill-switch for /api/remediate/apply and /api/remediate/rollback.
FLAREINSPECT_ALLOW_REMEDIATION=false
# Opaque secret (or JWT) the MCP/agent edit-scope check accepts.
# FLAREINSPECT_EDIT_SCOPE=

# ── Notifications (also settable in the dashboard → Settings) ───────────────
# FLAREINSPECT_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# FLAREINSPECT_TEAMS_WEBHOOK=https://.../webhookb2/...
# FLAREINSPECT_WEBHOOK_URL=https://example.com/hook
# FLAREINSPECT_WEBHOOK_SECRET=your-hmac-secret
# FLAREINSPECT_NOTIFY_THRESHOLD=high     # critical|high|medium|low|informational

# ── AI planner (also settable in the dashboard → Settings) ──────────────────
# FLAREINSPECT_AI_PROVIDER=none          # none|anthropic|openai|ollama
# FLAREINSPECT_AI_MODEL=claude-opus-4-8
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# ── SIEM (also settable in the dashboard → Settings) ────────────────────────
# FLAREINSPECT_ES_URL=https://es.example.com:9200
# FLAREINSPECT_ES_APIKEY=
# FLAREINSPECT_ES_USERNAME=
# FLAREINSPECT_ES_PASSWORD=
# FLAREINSPECT_SPLUNK_HEC_URL=https://splunk:8088
# FLAREINSPECT_SPLUNK_HEC_TOKEN=
